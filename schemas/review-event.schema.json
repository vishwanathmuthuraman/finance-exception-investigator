{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "enum": [
        "accepted",
        "dismissed",
        "requested_evidence"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "required": [
          "record_id",
          "pointer"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "report_id",
    "actor",
    "idempotency_key",
    "created_at",
    "action",
    "reason",
    "citations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "dismissed"
          }
        }
      },
      "then": {
        "properties": {
          "citations": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
